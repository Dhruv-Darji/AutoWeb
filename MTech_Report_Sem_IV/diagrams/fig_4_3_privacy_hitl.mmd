%% Figure 4.3 - HITL Gate and Privacy Hub
%% Shows PolicyHub rule injection on the Planner side and PrivacyPipeline on the Grounder side
%% Intended caption: "HITL gate and Privacy Hub. PolicyHub injects policy rules and risk keywords
%% into the Planner prompt; the Privacy-Aware LLM wrapper scrubs PII from element summaries before
%% the Grounder call."
flowchart TD
    subgraph PolicyHub
        PJ[policies.json<br/>15 default rules<br/>24 risk keywords]
        PA[get_active_policy domain]
        PK[get_policy_risk_keywords]
        PJ --> PA
        PJ --> PK
    end

    subgraph PlannerSide[Planner side]
        PROMPT[Planner Prompt]
        PA --> PROMPT
        PROMPT --> LLM[Planner LLM]
        LLM --> JSON[JSON output:<br/>sub_task, action_type, value,<br/>confidence, policy_risk, hitl_reason]
    end

    subgraph Filter[Filter stage]
        F20[Top-20 candidates<br/>with element summaries]
    end

    subgraph PrivacyPipeline[Privacy-Aware LLM wrapper]
        PII[PII Detector<br/>regex: email, phone, SSN,<br/>credit_card, IPv4, DOB,<br/>passport, Aadhaar, PAN,<br/>password_field]
        MASK[Mask with placeholders<br/>EMAIL_MASKED, ...]
        DP[DP noise<br/>Laplace scale = s / epsilon<br/>optional on score vector]
        INJ[Inject PRIVACY DIRECTIVE<br/>into system prompt]
        F20 --> PII --> MASK --> INJ
        MASK --> DP --> INJ
    end

    subgraph HITL[Risk-based HITL Gate]
        R1{policy_risk<br/>flag true?}
        R2{risk keyword<br/>in action or<br/>hitl_reason?}
        R3{confidence<br/>below 30?}
        BLOCK[Block -> Human Review]
        PASS[Pass -> Execute]
        JSON --> R1
        PK --> R2
        JSON --> R2
        JSON --> R3
        R1 -- yes --> BLOCK
        R2 -- yes --> BLOCK
        R3 -- yes --> BLOCK
        R1 -- no --> R2
        R2 -- no --> R3
        R3 -- no --> PASS
    end

    INJ --> G[Grounder LLM<br/>Qwen2.5 / Qwen3 local]
    G --> HITL
    PASS --> EXEC[Browser Driver<br/>execute action]
