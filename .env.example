# Model and Dataset Paths Configuration
# Copy this file to .env and update with your local paths

# Path to Qwen2-VL-2B-Instruct model directory
# Example (Linux/Mac): /home/user/models/Qwen2-VL-2B-Instruct
# Example (Windows): D:\Environments\Models\Qwen2-VL-2B
MODEL_PATH=D:\Environments\Models\Qwen2-VL-2B

# Path to Multimodal Mind2Web dataset directory
# Example (Linux/Mac): /home/user/datasets/multimodal-mind2web
# Example (Windows): D:\Environments\Datasets\multimodal-mind2web
DATASET_PATH=D:\Environments\Datasets\multimodal-mind2web

# Optional: Results output directory (default: ../results)
# RESULTS_PATH=../results

# ============================================================================
# GPU Configuration (Optional)
# ============================================================================

# Device to use for inference
# Options: "cuda" (GPU), "cpu", or "auto" (auto-detect)
# Default: auto (uses GPU if available, otherwise CPU)
# For NVIDIA RTX 4050 (6GB VRAM), use "cuda"
DEVICE=cuda

# Model precision/dtype
# Options: "fp16" (half precision, faster, less memory), "float32" (full precision)
# Default: fp16 (recommended for GPUs with 6GB+ VRAM like RTX 4050)
# Use fp16 for better performance on your 6GB RTX 4050
MODEL_DTYPE=fp16

# Use 8-bit quantization (requires bitsandbytes library)
# Options: true, false
# Default: false
# Set to true if you want to save more memory (can reduce VRAM usage by ~50%)
# Note: Requires: pip install bitsandbytes
USE_8BIT=false
